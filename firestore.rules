rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: obtener el rol del usuario autenticado (con fallback seguro)
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null ? userDoc.data.role : 'read_only';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isAdminOrComercial() {
      return isAuthenticated() && getUserRole() in ['admin', 'comercial'];
    }

    // Colección de usuarios: lectura para autenticados, escritura solo admin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Helper: allow public creates from external web forms (reactivatuedificio.es, serasanengineering.com).
    // These forms write directly to Firestore without Firebase Auth. Requires at least an email or
    // nombre/name field to prevent trivial spam. All other operations remain auth-gated.
    function isExternalFormSubmit() {
      return !isAuthenticated() &&
        (request.resource.data.get('email', '') != '' ||
         request.resource.data.get('nombre', '') != '' ||
         request.resource.data.get('name', '') != '');
    }

    // Colección unificada de leads (todas las fuentes: landing, web-download, web-contact, manual)
    match /leads/{leadId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrComercial() || isExternalFormSubmit();
      allow update: if isAdminOrComercial();
      allow delete: if isAdmin();

      // Subcollections: activity, tasks
      match /{subcol}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdminOrComercial();
      }
    }

    // Legacy collections — read-only access for backward compat, no new writes
    match /leads_descargas/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /{subcol}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /solicitudes_contacto/{leadId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /{subcol}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Colección global de tareas
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrComercial();
    }

    // Configuración global (alertas, etc.) — solo admin
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
